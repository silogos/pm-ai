{
  "name": "pm-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@pm-ai/web",
    "dev:api": "turbo run dev --filter=@pm-ai/api",
    "dev:mcp": "turbo run dev --filter=@pm-ai/mcp",
    "dev:app": "turbo run dev --filter=@silogos/pm-ai",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@pm-ai/web",
    "build:api": "turbo run build --filter=@pm-ai/web && turbo run build --filter=@pm-ai/api",
    "start": "turbo run start --filter=@pm-ai/api",
    "build:mcp": "turbo run build --filter=@pm-ai/mcp",
    "build:app": "turbo run build --filter=@silogos/pm-ai",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@pm-ai/db",
    "db:migrate": "turbo run db:migrate --filter=@pm-ai/db",
    "clean": "rm -rf apps/*/dist packages/*/dist node_modules/.cache",
    "pm-ai": "node apps/app/dist/index.js",
    "link:global": "cd apps/app && pnpm link --global",
    "unlink:global": "cd apps/app && pnpm unlink --global"
  },
  "devDependencies": {
    "turbo": "^2.8.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.25.0"
}
